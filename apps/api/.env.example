# Copy to .env and replace CHANGE_ME with the medicore_user password from pgAdmin 4.
# Primary (native Postgres + pgAdmin 4 on port 5432):
DATABASE_URL="postgresql://medicore_user:CHANGE_ME@localhost:5432/medicore_dev?schema=public"
# Optional Docker Compose alternative (see README) uses port 5433:
# DATABASE_URL="postgresql://medicore_user:medicore_dev_password@localhost:5433/medicore_dev?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Public contact form (optional — without RESEND_API_KEY, messages are logged and return 202)
HOSPITAL_CONTACT_EMAIL="contact@example.com"
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="MediCore <onboarding@resend.dev>"
