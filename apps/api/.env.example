# ─── Database (required) ───────────────────────────────────────
# Matches docker-compose.yml: user medicore, password medicore_dev_pass, port 5433
DATABASE_URL="postgresql://medicore:medicore_dev_pass@localhost:5433/medicore_dev"

# ─── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── JWT (required for real auth) ──────────────────────────────
JWT_SECRET=your-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-long-random-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Password hashing ────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
