# Local API environment template — copy to `.env` and replace placeholders.
# Keep apps/web/.env DATABASE_URL identical to this one.

DATABASE_URL="postgresql://medicore_user:YOUR_PASSWORD@localhost:5432/medicore_dev?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Public contact form (optional — without RESEND_API_KEY, messages are logged and return 202)
HOSPITAL_CONTACT_EMAIL="contact@example.com"
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="MediCore <onboarding@resend.dev>"

# Optional Docker Compose Postgres (host port 5433) — uncomment and comment the line above if you use Docker:
# DATABASE_URL="postgresql://medicore_user:medicore_dev_password@localhost:5433/medicore_dev?schema=public"
