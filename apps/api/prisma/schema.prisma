generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECHNICIAN
  BILLING_OFFICER
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  role               Role
  name               String?
  emailVerified      DateTime?
  image              String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient  Patient?
  staff    Staff?
  accounts Account[]
  sessions Session[]
  notifications Notification[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  staff             Staff[]
  wards             Ward[]
  inventoryItems    InventoryItem[]
  equipment         Equipment[]
  symptomCategories SymptomCategory[]
}

model Specialty {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  staff Staff[]
}

model Staff {
  id                   String   @id @default(uuid())
  userId               String   @unique
  employeeCode         String   @unique
  departmentId         String
  designation          String
  specialization       String?
  specialtyId          String?
  licenseNumber        String?
  qualification        String?
  experienceYears      Int?
  consultationRoom     String?
  consultationFeeCents Int?
  wardId               String?
  shiftPattern         String?
  dateJoined           DateTime @default(now())
  isActive             Boolean  @default(true)

  user           User                  @relation(fields: [userId], references: [id])
  department     Department            @relation(fields: [departmentId], references: [id])
  specialty      Specialty?            @relation(fields: [specialtyId], references: [id])
  ward           Ward?                 @relation(fields: [wardId], references: [id])
  availability   StaffAvailability[]
  leaveRequests  StaffLeaveRequest[]
  appointments   Appointment[]
  waitlist       AppointmentWaitlist[]
  encounters     Encounter[]
  prescriptions  Prescription[]
  surgeryRequestsRequested SurgeryRequest[] @relation("SurgeryRequestedBy")
  surgeriesAsPrimary       SurgeryRequest[] @relation("SurgeryPrimarySurgeon")
}

model StaffAvailability {
  id               String @id @default(uuid())
  staffId          String
  dayOfWeek        Int
  startTime        String
  endTime          String
  slotDurationMins Int    @default(15)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffLeaveRequest {
  id         String      @id @default(uuid())
  staffId    String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Patient {
  id                 String      @id @default(uuid())
  userId             String?     @unique
  mrn                String      @unique
  firstName          String
  lastName           String
  dob                DateTime
  gender             Gender
  phone              String
  email              String?
  address            String?
  bloodGroup         BloodGroup  @default(UNKNOWN)
  emergencyName      String?
  emergencyPhone     String?
  emergencyRelation  String?
  insuranceProvider  String?
  insurancePolicyNo  String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  user      User?             @relation(fields: [userId], references: [id])
  allergies PatientAllergy[]
  documents PatientDocument[]
  appointments Appointment[]
  waitlist     AppointmentWaitlist[]
  encounters   Encounter[]
  prescriptions Prescription[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  admissions        Admission[]
  invoices          Invoice[]
  intakes           PatientIntake[]
  surgeryRequests   SurgeryRequest[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([mrn])
}

model PatientAllergy {
  id        String          @id @default(uuid())
  patientId String
  allergen  String
  severity  AllergySeverity
  notes     String?
  createdAt DateTime        @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientDocument {
  id         String   @id @default(uuid())
  patientId  String
  uploadedBy String
  fileUrl    String
  docType    String
  createdAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  NO_SHOW
}

enum AppointmentPriority {
  LOW
  NORMAL
  URGENT
  EMERGENCY
}

enum AppointmentSource {
  PATIENT_PORTAL
  RECEPTION
  PHONE
  WALK_IN
}

enum AppointmentVisitType {
  NEW_PATIENT
  FOLLOW_UP
  ROUTINE
}

enum AppointmentEventType {
  APPOINTMENT_CREATED
  STATUS_CHANGED
  DOCTOR_ASSIGNED
  DOCTOR_CHANGED
  RESCHEDULE_REQUESTED
  RESCHEDULE_APPROVED
  ALTERNATIVE_OFFERED
  PATIENT_CHECKED_IN
  REMINDER_SENT
  PRIORITY_CHANGED
}

enum RejectionReasonCode {
  DOCTOR_UNAVAILABLE
  CLINIC_CLOSED
  DUPLICATE_BOOKING
  PATIENT_REQUESTED_CANCEL
  OTHER
}

model Appointment {
  id                  String                 @id @default(uuid())
  patientId           String
  doctorId            String
  scheduledAt         DateTime
  durationMinutes     Int                    @default(15)
  status              AppointmentStatus      @default(PENDING)
  priority            AppointmentPriority    @default(NORMAL)
  appointmentSource   AppointmentSource      @default(RECEPTION)
  visitType           AppointmentVisitType   @default(ROUTINE)
  reasonForVisit      String?
  createdBy           String
  cancelReason        String?
  rejectionReasonCode RejectionReasonCode?
  rejectionReason     String?
  pendingExpiresAt    DateTime?
  confirmedAt         DateTime?
  confirmedById       String?
  assignedDoctorAt    DateTime?
  assignedDoctorById  String?
  checkedInAt         DateTime?
  inProgressAt        DateTime?
  completedAt         DateTime?
  isWalkIn            Boolean                @default(false)
  queueNumber         Int?
  offeredAlternatives Json?
  rescheduleRequestedAt DateTime?
  rescheduleRequestedSlot DateTime?
  rescheduleRequestedDoctorId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Staff   @relation(fields: [doctorId], references: [id])
  encounter Encounter?
  intake  PatientIntake?
  events  AppointmentEvent[]

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status, pendingExpiresAt])
  @@index([status, priority])
}

model AppointmentEvent {
  id            String               @id @default(uuid())
  appointmentId String
  eventType     AppointmentEventType
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus?
  actorUserId   String?
  note          String?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime             @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

enum IntakeSeverity {
  MILD
  MODERATE
  SEVERE
}

model SymptomCategory {
  id                    String  @id @default(uuid())
  name                  String
  description           String?
  suggestedDepartmentId String

  suggestedDepartment Department      @relation(fields: [suggestedDepartmentId], references: [id])
  intakes             PatientIntake[]

  @@index([suggestedDepartmentId])
}

model PatientIntake {
  id                 String         @id @default(uuid())
  patientId          String
  symptomCategoryId  String
  chiefComplaintText String
  durationValue      Int
  durationUnit       String
  severity           IntakeSeverity
  redFlagsSelected   Json
  isUrgent           Boolean        @default(false)
  appointmentId      String?        @unique
  lockedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id])
  symptomCategory SymptomCategory @relation(fields: [symptomCategoryId], references: [id])
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([symptomCategoryId])
}

model AppointmentWaitlist {
  id            String    @id @default(uuid())
  patientId     String
  doctorId      String
  preferredDate DateTime
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Staff   @relation(fields: [doctorId], references: [id])
}

enum EncounterStatus {
  IN_PROGRESS
  FINALIZED
}

model Encounter {
  id             String          @id @default(uuid())
  patientId      String
  doctorId       String
  appointmentId  String?         @unique
  encounterDate  DateTime        @default(now())
  chiefComplaint String?
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  status         EncounterStatus @default(IN_PROGRESS)
  finalizedAt    DateTime?
  invoicedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  doctor      Staff        @relation(fields: [doctorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  revisions       EncounterRevision[]
  diagnoses       Diagnosis[]
  vitals          Vitals[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  surgeryRequests SurgeryRequest[]

  @@index([patientId])
  @@index([doctorId])
}

model EncounterRevision {
  id          String   @id @default(uuid())
  encounterId String
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  revisedBy   String
  isAddendum  Boolean  @default(false)
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
}

model Diagnosis {
  id          String  @id @default(uuid())
  encounterId String
  icdCode     String?
  description String

  encounter Encounter @relation(fields: [encounterId], references: [id])
}

model Vitals {
  id          String   @id @default(uuid())
  encounterId String
  recordedBy  String
  bpSystolic  Int?
  bpDiastolic Int?
  temperatureC Float?
  pulseBpm    Int?
  weightKg    Float?
  heightCm    Float?
  recordedAt  DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])
}

model Medicine {
  id               String @id @default(uuid())
  name             String
  genericName      String?
  form             String
  strength         String
  reorderThreshold Int    @default(10)
  sellingPriceCents Int   @default(0)

  prescriptionItems  PrescriptionItem[]
  batches            MedicineBatch[]
  purchaseOrderItems PurchaseOrderItem[]
}

enum PrescriptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum PharmacyStage {
  PENDING_REVIEW
  PREPARING
  READY_FOR_PICKUP
  COMPLETED
}

model Prescription {
  id            String             @id @default(uuid())
  encounterId   String
  patientId     String
  doctorId      String
  status        PrescriptionStatus @default(PENDING)
  pharmacyStage PharmacyStage      @default(PENDING_REVIEW)
  createdAt     DateTime           @default(now())

  encounter Encounter          @relation(fields: [encounterId], references: [id])
  patient   Patient            @relation(fields: [patientId], references: [id])
  doctor    Staff              @relation(fields: [doctorId], references: [id])
  items     PrescriptionItem[]
}

model PrescriptionItem {
  id                 String @id @default(uuid())
  prescriptionId     String
  medicineId         String
  dosage             String
  frequency          String
  durationDays       Int
  quantityPrescribed Int    @default(1)
  notes              String?

  prescription               Prescription               @relation(fields: [prescriptionId], references: [id])
  medicine                   Medicine                   @relation(fields: [medicineId], references: [id])
  dispenses                  Dispense[]
  medicationAdministrations  MedicationAdministration[]
}

model MedicineBatch {
  id              String   @id @default(uuid())
  medicineId      String
  batchNo         String
  quantityInStock Int
  unitCostCents   Int
  expiryDate      DateTime
  receivedAt      DateTime @default(now())

  medicine  Medicine   @relation(fields: [medicineId], references: [id])
  dispenses Dispense[]

  @@index([medicineId, expiryDate])
}

model Dispense {
  id                 String    @id @default(uuid())
  prescriptionItemId String
  batchId            String
  quantityDispensed  Int
  dispensedBy        String
  dispensedAt        DateTime  @default(now())
  invoicedAt         DateTime?

  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  batch            MedicineBatch    @relation(fields: [batchId], references: [id])
}

model Supplier {
  id            String  @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?
  receivedAt DateTime?
  createdAt  DateTime            @default(now())

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  medicineId      String
  quantity        Int
  unitCostCents   Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  medicine      Medicine      @relation(fields: [medicineId], references: [id])
}

enum LabResultType {
  NUMERIC
  TEXT
  FILE
}

model LabTestCatalog {
  id              String        @id @default(uuid())
  name            String
  category        String
  priceCents      Int
  sampleType      String
  turnaroundHours Int
  resultType      LabResultType
  unit            String?
  referenceLow    Float?
  referenceHigh   Float?
  criticalLow     Float?
  criticalHigh    Float?

  orderItems LabOrderItem[]
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model LabOrder {
  id          String         @id @default(uuid())
  encounterId String
  patientId   String
  orderedBy   String
  status      LabOrderStatus @default(ORDERED)
  createdAt   DateTime       @default(now())

  encounter Encounter      @relation(fields: [encounterId], references: [id])
  patient   Patient        @relation(fields: [patientId], references: [id])
  items     LabOrderItem[]
}

enum LabOrderItemStatus {
  ORDERED
  COLLECTED
  RESULTED
}

model LabOrderItem {
  id         String             @id @default(uuid())
  labOrderId String
  testId     String
  status     LabOrderItemStatus @default(ORDERED)
  invoicedAt DateTime?

  labOrder LabOrder       @relation(fields: [labOrderId], references: [id])
  test     LabTestCatalog @relation(fields: [testId], references: [id])
  result   LabResult?
}

model LabResult {
  id                 String    @id @default(uuid())
  labOrderItemId     String    @unique
  resultValueNumeric Float?
  resultValueText    String?
  resultFileUrl      String?
  isCritical         Boolean   @default(false)
  enteredBy          String
  verifiedBy         String?
  resultedAt         DateTime  @default(now())
  verifiedAt         DateTime?

  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id])
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Ward {
  id           String @id @default(uuid())
  name         String
  departmentId String
  floor        Int

  department Department @relation(fields: [departmentId], references: [id])
  beds       Bed[]
  staff      Staff[]
}

model Bed {
  id             String    @id @default(uuid())
  wardId         String
  bedNumber      String
  bedType        String
  dailyRateCents Int
  status         BedStatus @default(AVAILABLE)

  ward       Ward        @relation(fields: [wardId], references: [id])
  admissions Admission[]

  @@unique([wardId, bedNumber])
}

model Admission {
  id                  String    @id @default(uuid())
  patientId           String
  bedId               String
  admittedBy          String
  admittedAt          DateTime  @default(now())
  expectedDischargeAt DateTime?
  dischargedAt        DateTime?
  dischargeSummary    String?
  carePlan            String?
  invoicedAt          DateTime?

  patient                     Patient                     @relation(fields: [patientId], references: [id])
  bed                         Bed                         @relation(fields: [bedId], references: [id])
  transfers                   BedTransfer[]
  nursingNotes                NursingNote[]
  medicationAdministrations   MedicationAdministration[]

  @@index([patientId])
  @@index([bedId])
}

model NursingNote {
  id          String   @id @default(uuid())
  admissionId String
  authorId    String
  body        String
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
}

model MedicationAdministration {
  id                 String   @id @default(uuid())
  admissionId        String
  prescriptionItemId String?
  medicineName       String
  dose               String
  route              String
  givenAt            DateTime @default(now())
  givenBy            String
  notes              String?

  admission        Admission         @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id])

  @@index([admissionId])
}

model BedTransfer {
  id            String   @id @default(uuid())
  admissionId   String
  fromBedId     String
  toBedId       String
  transferredAt DateTime @default(now())
  reason        String?

  admission Admission @relation(fields: [admissionId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum InvoiceSourceType {
  CONSULTATION
  LAB
  PHARMACY
  BED
  RADIOLOGY
  SURGERY
  OTHER
}

enum RadiologyOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RadiologyItemStatus {
  ORDERED
  IN_PROGRESS
  REPORTED
}

model RadiologyModality {
  id         String @id @default(uuid())
  name       String @unique
  code       String @unique
  priceCents Int    @default(0)

  orderItems RadiologyOrderItem[]
}

model RadiologyOrder {
  id          String               @id @default(uuid())
  encounterId String
  patientId   String
  orderedBy   String
  status      RadiologyOrderStatus @default(ORDERED)
  createdAt   DateTime             @default(now())

  encounter Encounter            @relation(fields: [encounterId], references: [id])
  patient   Patient              @relation(fields: [patientId], references: [id])
  items     RadiologyOrderItem[]
}

model RadiologyOrderItem {
  id               String              @id @default(uuid())
  radiologyOrderId String
  modalityId       String
  status           RadiologyItemStatus @default(ORDERED)
  invoicedAt       DateTime?

  radiologyOrder RadiologyOrder  @relation(fields: [radiologyOrderId], references: [id], onDelete: Cascade)
  modality       RadiologyModality @relation(fields: [modalityId], references: [id])
  report         RadiologyReport?

  @@index([radiologyOrderId])
}

model RadiologyReport {
  id                   String   @id @default(uuid())
  radiologyOrderItemId String   @unique
  findings             String?
  impression           String?
  reportFileUrl        String?
  enteredBy            String
  reportedAt           DateTime @default(now())

  radiologyOrderItem RadiologyOrderItem @relation(fields: [radiologyOrderItemId], references: [id], onDelete: Cascade)
}

enum SurgeryStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SurgeryUrgency {
  ELECTIVE
  URGENT
  EMERGENCY
}

model SurgeryRequest {
  id              String         @id @default(uuid())
  patientId       String
  encounterId     String?
  requestedBy     String
  procedureName   String
  urgency         SurgeryUrgency @default(ELECTIVE)
  status          SurgeryStatus  @default(REQUESTED)
  feeCents        Int?
  orRoom          String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  primarySurgeonId String?
  scheduleNotes   String?
  operativeNotes  String?
  invoicedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patient         Patient    @relation(fields: [patientId], references: [id])
  encounter       Encounter? @relation(fields: [encounterId], references: [id])
  requestedByStaff Staff     @relation("SurgeryRequestedBy", fields: [requestedBy], references: [id])
  primarySurgeon  Staff?     @relation("SurgeryPrimarySurgeon", fields: [primarySurgeonId], references: [id])

  @@index([patientId])
  @@index([status])
}

enum PaymentMethod {
  CASH
  CARD
  INSURANCE
  BANK_TRANSFER
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  DENIED
}

model Invoice {
  id            String        @id @default(uuid())
  patientId     String
  status        InvoiceStatus @default(DRAFT)
  subtotalCents Int           @default(0)
  taxCents      Int           @default(0)
  discountCents Int           @default(0)
  totalCents    Int           @default(0)
  voidReason    String?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())

  patient  Patient          @relation(fields: [patientId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
  claims   InsuranceClaim[]

  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id             String            @id @default(uuid())
  invoiceId      String
  sourceType     InvoiceSourceType
  sourceId       String?
  description    String
  quantity       Int               @default(1)
  unitPriceCents Int
  lineTotalCents Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(uuid())
  invoiceId      String
  method         PaymentMethod
  amountCents    Int
  transactionRef String?
  paidAt         DateTime      @default(now())
  recordedBy     String

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InsuranceClaim {
  id           String      @id @default(uuid())
  invoiceId    String
  provider     String
  policyNo     String
  claimedCents Int
  status       ClaimStatus @default(SUBMITTED)
  submittedAt  DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum ReasonCode {
  RECEIVED
  USED
  DAMAGED
  EXPIRED
  MISCOUNT
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE
  RETIRED
}

model InventoryItem {
  id               String @id @default(uuid())
  name             String
  category         String
  departmentId     String
  unit             String
  reorderThreshold Int    @default(10)
  currentStock     Int    @default(0)

  department   Department             @relation(fields: [departmentId], references: [id])
  transactions InventoryTransaction[]

  @@index([departmentId])
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  itemId      String
  type        TransactionType
  quantity    Int
  reasonCode  ReasonCode
  performedBy String
  createdAt   DateTime        @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

model Equipment {
  id               String          @id @default(uuid())
  name             String
  departmentId     String
  serialNo         String          @unique
  status           EquipmentStatus @default(OPERATIONAL)
  lastServicedAt   DateTime?
  nextServiceDueAt DateTime?

  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model ReportSnapshot {
  id          String   @id @default(uuid())
  reportType  String
  paramsJson  Json
  format      String
  generatedBy String
  generatedAt DateTime @default(now())

  @@index([reportType])
  @@index([generatedAt])
  @@index([generatedBy])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // "CREATE" | "UPDATE" | "DELETE" | "VIEW"
  resourceType String   // e.g. "Patient", "Invoice"
  resourceId   String?
  beforeJson   Json?
  afterJson    Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([userId])
  @@index([createdAt])
}

model HospitalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
